{
  "name": "meilisearch-fumadocs-adapter",
  "version": "0.1.0",
  "description": "Meilisearch search adapter for Fumadocs — community maintained",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clean false",
    "clean": "rimraf dist",
    "test": "vitest run --passWithNoTests",
    "types:check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm types:check && pnpm lint && pnpm format:check",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "meilisearch": ">=0.50.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "hast-util-to-html": "^9.0.5",
    "mdast-util-mdx": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.7",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "meilisearch": "^0.62.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "tsdown": "0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.1"
  }
}
